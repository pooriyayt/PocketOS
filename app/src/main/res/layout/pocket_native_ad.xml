<?xml version="1.0" encoding="utf-8"?>
<!--
  Native ad template for AdiveryNativeAdView. The SDK fills the views by id:
  adivery_wrapper, adivery_image, adivery_icon, adivery_headline,
  adivery_description, adivery_advertiser, adivery_call_to_action.
  Colours are applied from code so the card follows the in-app theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adivery_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.adivery.sdk.AdiveryNativeAdMediaView
        android:id="@+id/adivery_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/adivery_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/adivery_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_bold"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/adivery_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_regular"
                android:maxLines="2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/adivery_advertiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_regular"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/adivery_call_to_action"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ad_cta_background"
        android:fontFamily="@font/vazirmatn_bold"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />
</LinearLayout>
